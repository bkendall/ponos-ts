{
  "name": "ponos-ts",
  "version": "1.0.1",
  "description": "Typescript port of Ponos",
  "repository": "https://github.com/bkendall/ponos-ts",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf lib",
    "coverage": "c8 mocha 'test/**/*.ts'",
    "lint": "eslint src",
    "prepare": "npm run build",
    "test": "npm run lint && npm run build && npm run test:mocha",
    "test:coverage": "npm run coverage",
    "test:mocha": "mocha 'test/**/*.ts'",
    "test:functional": "mocha 'test-functional/**/*.ts'",
    "test:watch": "mocha -w --watch-extensions ts 'test/**/*.ts'"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**/*",
      "test-functional/**/*",
      "example/**/*"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ]
  },
  "author": "Bryan Kendall <bryan@bryankendall.com>",
  "license": "MIT",
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@types/chai": "^5.0.0",
    "@types/chai-as-promised": "^8.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "mocha": "^11.8.0",
    "prettier": "^3.4.2",
    "sinon": "^22.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "amqplib": "^2.0.1"
  }
}
