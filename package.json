{
  "name": "ponos-ts",
  "version": "0.0.2",
  "description": "Typescript port of Ponos",
  "repository": "https://github.com/bkendall/ponos-ts",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf lib",
    "coveralls": "nyc report --reporter text-lcov | coveralls",
    "lint": "eslint src",
    "prepare": "npm run build",
    "test": "npm run lint && npm run build && npm run test:mocha",
    "test:mocha": "mocha 'test/**/*.ts'",
    "test:functional": "mocha 'test-functional/**/*.ts'",
    "test:watch": "mocha -w --watch-extensions ts 'test/**/*.ts'"
  },
  "nyc": {
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "example/**/*"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "html",
      "text-summary"
    ],
    "all": true
  },
  "author": "Bryan Kendall <bryan@bryankendall.com>",
  "license": "MIT",
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^5.0.0",
    "@types/chai-as-promised": "^8.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.1",
    "coveralls": "^3.1.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "mocha": "^10.8.2",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2",
    "sinon": "^19.0.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "bluebird": "^3.7.2"
  }
}
